msgid "Choose a path to store the file on its mount. Maximum 5 MB per file."
msgstr "Выберите путь для сохранения файла в хранилище. Максимальный размер файла — 5 МБ."

msgid "Import a document"
msgstr "Импорт документа"

msgid "Import Markdown, text, CSV, Word, draw.io, or Obsidian Canvas, or native .wiki.json files, or portable .wiki.zip bundles."
msgstr "Импортируйте Markdown, текст, CSV, Word, draw.io, Obsidian Canvas, файлы .wiki.json или переносимые архивы .wiki.zip."

msgid "Choose a file (UTF-8 up to 5 MB; .docx files become editable wiki documents; .doc files remain downloadable; .wiki.zip bundles up to 50 MB)"
msgstr "Выберите файл (UTF-8 до 5 МБ; .docx преобразуются в редактируемые документы вики; .doc остаются доступными для скачивания; архивы .wiki.zip — до 50 МБ)"

msgid "The file will be added at /. You can move it to another mount after importing. External changes to the original file are not synchronized."
msgstr "Файл будет добавлен в /. После импорта его можно переместить в другое хранилище. Внешние изменения исходного файла не синхронизируются."

msgid "Import file"
msgstr "Импортировать файл"

msgid "Give it a name and choose where it belongs."
msgstr "Укажите название и выберите расположение."

msgid "Use / for the workspace root. A new directory inherits its parent’s permissions."
msgstr "Используйте / для корня рабочего пространства. Новый каталог наследует права родительского каталога."

msgid "Create directory"
msgstr "Создать каталог"

msgid "Destination"
msgstr "Место назначения"

msgid "Workspace root (/)"
msgstr "Корень рабочего пространства (/)"

msgid "This item inherits permissions. Moving it changes access to match the destination’s rules. Its ownership stays the same."
msgstr "Этот объект наследует права доступа. После перемещения права будут соответствовать правилам каталога назначения. Владелец останется прежним."

msgid "This item keeps its explicit permissions."
msgstr "Этот объект сохраняет явно заданные права доступа."

msgid "Confirm move"
msgstr "Подтвердить перемещение"

msgid "This removes the document from the wiki and its current file from storage. Older revision files retained for recovery are not removed."
msgstr "Документ будет удалён из вики, а его текущий файл — из хранилища. Старые версии, сохранённые для восстановления, не удаляются."

