msgstr "Участники не найдены."

msgid "Create groups and manage their members. File and folder permissions are configured separately."
msgstr "Создавайте группы и выбирайте участников. Права на файлы и папки настраиваются отдельно."

msgid "Manage group"
msgstr "Настроить группу"

msgid "Create a group to organize access for your team."
msgstr "Создайте группу, чтобы настроить общий доступ для команды."

msgid "Choose who belongs to this group. Changes affect access granted to the group."
msgstr "Выберите участников группы. Изменения повлияют на доступ, предоставленный этой группе."

msgid "Find a member"
msgstr "Найти участника"

msgid "Name or username"
msgstr "Имя или логин"

