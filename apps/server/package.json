{
  "name": "@yourwiki/server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node src/main.ts",
    "worker": "node --max-old-space-size=384 src/worker/main.ts",
    "provider-worker": "node --max-old-space-size=128 src/providers/worker-main.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "markdown-it": "15.0.3",
    "sanitize-html": "2.18.1",
    "saxes": "6.0.0",
    "tar-stream": "3.2.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/sanitize-html": "2.16.2",
    "@types/tar-stream": "3.1.5",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "typescript": "7.0.2"
  }
}
