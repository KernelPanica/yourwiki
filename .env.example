# Copy to .env for a NEW install only. Existing installations keep their .env.
YOURWIKI_PUBLIC_URL=http://127.0.0.1:3000
YOURWIKI_PORT=3000
YOURWIKI_DRIVE_TRANSPORT=rclone
COMPOSE_FILE=compose.yaml:compose.rclone.yaml

# For a public deployment, use the actual HTTPS origins, without paths.
# YOURWIKI_PUBLIC_URL=https://wiki.example.com
# YourSpace is opt-in through the SSO Compose override. Leave empty until ready.
YOURWIKI_YOURSPACE_ISSUER=
# Example: YOURWIKI_YOURSPACE_ISSUER=https://space.example.com
# The SSO override supplies client ID yourwiki and mounts the secret as a file.
# See docs/yourspace-auth-migration.md. Do not put the secret in .env.

# Optional settings. Public Collabora requires the Collabora Compose override.
# COLLABORA_URL=https://wiki.example.com/collabora
# COLLABORA_WOPI_URL=https://wiki.example.com
# YOURWIKI_RCLONE_DATA=/var/lib/yourwiki/rclone
# YOURWIKI_RCLONE_RUNTIME=/var/lib/yourwiki/rclone-runtime
# YOURWIKI_BACKUPS=./backups
# YOURWIKI_MIGRATION_SOURCE=./migration-source
